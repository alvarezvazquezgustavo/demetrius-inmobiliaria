# =========================================================
#  Demetrius Grupo Inmobiliario — Variables de entorno
#
#  1. Copia este archivo como ".env" y llena los valores reales.
#  2. ".env" está en .gitignore: NUNCA lo subas a GitHub.
#  3. Estas llaves se usan SOLO del lado del servidor
#     (función serverless de Netlify/Vercel o un backend).
#     Todo lo que se escribe en index.html o en js/ es público.
# =========================================================

# ---- Sitio ----
SITE_URL=https://inmobiliariademetrius.com
CONTACT_EMAIL=inmobiliriademetrius@gmail.com
WHATSAPP_NUMBER=5213351070944

# ---- Google Analytics 4 ----
# Es un ID público: cópialo también en GA_MEASUREMENT_ID dentro de js/principal.js
GA_MEASUREMENT_ID=G-XXXXXXXXXX

# ---- Supabase (reseñas de la comunidad) ----
# La URL y la "Publishable key" (o "anon public") son PÚBLICAS: se copian también
# en ENV_CONFIG.SUPABASE_URL / SUPABASE_ANON_KEY dentro de js/principal.js.
# La "Secret key" / "service_role" es PRIVADA: jamás va en el código ni en GitHub.
SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ---- EasyBroker (API privada) ----
# Panel EasyBroker → Integraciones → API. Úsala desde una función serverless
# y apunta ENV_CONFIG.EASYBROKER_PROXY_URL (js/principal.js) a esa función.
EASYBROKER_API_KEY=
EASYBROKER_API_URL=https://api.easybroker.com/v1

# ---- Mapas (solo si cambias OpenStreetMap por un proveedor con llave) ----
# Restringe siempre la llave a tu dominio desde la consola del proveedor.
GOOGLE_MAPS_API_KEY=
MAPBOX_ACCESS_TOKEN=

# ---- WhatsApp Business Cloud API (opcional, automatizaciones) ----
WHATSAPP_CLOUD_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
